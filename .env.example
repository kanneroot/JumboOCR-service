# ==============================================================================
# Environment Configuration Template for PDF to Word Microservice
# Copy this file to `.env` and fill in your DashScope API Key.
# ==============================================================================

# Alibaba Cloud DashScope API Key (Required for Qwen3.7-Flash VLM OCR)
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# DashScope OpenAI-Compatible Endpoint Base URL
DASHSCOPE_BASE_URL=https://ws-11apde4s0qdodprl.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

# Target Model Name (Default: qwen3.7-flash)
MODEL_NAME=qwen3.7-flash

# PDF Rendering Resolution (DPI). 200 DPI offers optimal accuracy vs memory tradeoff.
RENDER_DPI=200

# Concurrency control: Maximum simultaneous pages processed per request
MAX_CONCURRENT_PAGES=6

# Maximum allowed file upload size in Megabytes (MB)
MAX_FILE_SIZE_MB=50

# Service Port and Host
HOST=0.0.0.0
PORT=8000

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
